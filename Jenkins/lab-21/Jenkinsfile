pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'mostafaosmanfathi/ivolve-nodejs-app'
    }

    stages {
        stage('Build app') {
            steps {
                sh 'npm install'
                sh 'node --check server.js'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t ${DOCKER_IMAGE}:${BUILD_NUMBER} .'
            }
        }

        stage('Scan Docker Image') {
            steps {
                sh 'trivy image --exit-code 0 --severity HIGH,CRITICAL --no-progress ${DOCKER_IMAGE}:${BUILD_NUMBER}'
            }
        }

        stage('Docker Login') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'DockerHub',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh 'echo "$DOCKER_PASSWORD" | docker login -u "$DOCKER_USERNAME" --password-stdin'
                }
            }
        }

        stage('Push image to DockerHub') {
            steps {
                sh 'docker push ${DOCKER_IMAGE}:${BUILD_NUMBER}'
            }
        }

        stage('Update image in deployment file') {
            steps {
                sh "sed -i 's|mostafaosmanfathi/ivolve-nodejs-app:.*|${DOCKER_IMAGE}:${BUILD_NUMBER}|' k8s-project/deployment-nodjs.yaml"
            }
        }

        stage('Configure kubectl') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'k8s-jenkins-token',
                        variable: 'K8S_TOKEN'
                    )
                ]) {
                    sh '''
                    kubectl config set-cluster k8s-cluster \
                    --server=https://192.168.122.54:6443 \


                    kubectl config set-credentials jenkins \
                    --token="$K8S_TOKEN"

                    kubectl config set-context jenkins \
                    --cluster=k8s-cluster \
                    --user=jenkins \
                    --namespace=ivolve

                    kubectl config use-context jenkins
                    '''
                }
            }
        }

        stage('Create image pull secret') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'DockerHub',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        kubectl create secret docker-registry dockerhub-secret \
                          --docker-server=https://index.docker.io/v1/ \
                          --docker-username="$DOCKER_USERNAME" \
                          --docker-password="$DOCKER_PASSWORD" \
                          --namespace=ivolve \
                          --dry-run=client -o yaml | kubectl apply -f -
                    '''
                }
            }
        }

        stage('Apply deployment') {
            steps {
                sh 'kubectl apply -f k8s-project/deployment-nodjs.yaml'
            }
        }

        stage('Rollout status') {
            steps {
                sh 'kubectl rollout status deployment/ivolveapp -n ivolve --timeout=600s'
            }
        }

        stage('Delete image locally') {
            steps {
                sh 'docker rmi ${DOCKER_IMAGE}:${BUILD_NUMBER} || true'
            }
        }
    }

    post {
        always {
            sh 'docker logout || true'
            echo '======== always ========'
        }
        success {
            echo 'Pipeline completed successfully.'
        }
        failure {
            echo '======== pipeline execution failed ========'
        }
    }
}
